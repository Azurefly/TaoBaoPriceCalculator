{
  "name": "taobao-price-calculator",
  "productName": "TaoBaoPriceCalculator",
  "version": "0.3.2",
  "description": "Local promotion payment-path calculator / 本地优惠付款路径计算器",
  "author": "Azurefly",
  "private": true,
  "main": "main.cjs",
  "homepage": "https://github.com/Azurefly/TaoBaoPriceCalculator",
  "scripts": {"start": "electron .", "test": "node --test tests*.cjs", "dist": "electron-builder --config builder.config.cjs --publish never"},
  "devDependencies": {"electron": "45.2.3", "electron-builder": "26.18.0"},
  "build": {
    "appId": "io.github.azurefly.taobaopricecalculator",
    "productName": "TaoBaoPriceCalculator",
    "artifactName": "TaoBaoPriceCalculator-${version}-${os}-${arch}.${ext}",
    "directories": {"output": "../release"},
    "files": ["main.cjs", "security.cjs", "package.json"],
    "extraResources": [{"from": "../dist/TaoBaoPriceCalculator-service", "to": "backend"}],
    "asar": true,
    "npmRebuild": false,
    "afterPack": "./sign-backend.cjs",
    "win": {"target": ["nsis"], "signAndEditExecutable": false},
    "nsis": {
      "oneClick": false, "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true, "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false, "runAfterFinish": false,
      "artifactName": "TaoBaoPriceCalculator-${version}-windows-${arch}-setup.exe"
    },
    "mac": {
      "target": ["dmg"], "category": "public.app-category.finance",
      "identity": "-", "hardenedRuntime": true, "notarize": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "minimumSystemVersion": "13.0"
    },
    "linux": {"executableName": "taobao-price-calculator", "target": ["AppImage", "deb"], "category": "Utility", "maintainer": "Azurefly"},
    "publish": null
  }
}
